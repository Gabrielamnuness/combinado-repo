# ── Ambiente ──────────────────────────────────────────────
# development em casa, production no ar. Em production o servidor não sobe sem JWT_SECRET forte e APP_URL em https.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TIMEZONE=America/Sao_Paulo

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-bem-grande-e-aleatorio

# Caminho do banco SQLite. Em produção aponte para um disco persistente.
DB_PATH=./combinado.db

# ── IA (Anthropic) ───────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── WhatsApp (Meta Cloud API) ────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Palavra secreta que você digita ao configurar o webhook na Meta.
WHATSAPP_VERIFY_TOKEN=escolha-uma-palavra-secreta
# App Secret do app na Meta (Configurações do app > Básico). Valida que o webhook veio da Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Templates aprovados na Meta (corpo com um único parâmetro {{1}}).
# Necessários para lembretes e avisos fora da janela de 24h.
WHATSAPP_TEMPLATE_LEMBRETE=
WHATSAPP_TEMPLATE_DONO=

# ── Cobrança (Stripe) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Um Price por plano, criado no Stripe. Trimestral = intervalo mensal com interval_count 3.
STRIPE_PRICE_ID_MENSAL=
STRIPE_PRICE_ID_TRIMESTRAL=
STRIPE_PRICE_ID_ANUAL=
# Só para testes locais: permite ativar assinatura sem Stripe em production.
ALLOW_DEMO_BILLING=0

# ── Recebimento (você) ────────────────────────────────────
# O depósito vai para a conta bancária cadastrada no Stripe. Aqui ficam só os rótulos
# que aparecem nos registros e o WhatsApp que recebe o aviso a cada cadastro e pagamento.
OWNER_NOME=
OWNER_RECEBEDOR=
OWNER_WHATSAPP=

# ── Administração ─────────────────────────────────────────
# Token para GET /admin/resumo (mínimo 16 caracteres). Vazio = rota desligada.
ADMIN_TOKEN=
# Simulador de WhatsApp sem login. Deixe vazio em produção.
PLAYGROUND_ENABLED=
